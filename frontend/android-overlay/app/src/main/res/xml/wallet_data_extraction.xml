<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de l'appli (jeton d'accès, cache des widgets) ne part dans une sauvegarde Google
     ni dans un transfert vers un nouveau téléphone : il faudra simplement se reconnecter. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
