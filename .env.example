# Copie ce fichier en .env (ou lance scripts\init-env.ps1 qui le fait pour toi).
# Mot de passe de l'appli. Mieux : son empreinte, générée par
#   docker compose exec api python -m app.tools.hash_password
# puis APP_PASSWORD_HASH=scrypt:… à la place de APP_PASSWORD (le mot de passe n'est alors écrit nulle part).
APP_PASSWORD=change-moi
# APP_PASSWORD_HASH=
SECRET_KEY=une-longue-chaine-aleatoire
# Cle Fernet : 32 octets aleatoires encodes en base64 "url-safe".
ENCRYPTION_KEY=
POSTGRES_PASSWORD=une-autre-chaine-aleatoire
# Cookie de session « Secure » (HTTPS). true marche avec Tailscale (https://…ts.net) et http://localhost.
COOKIE_SECURE=true

# --- Synchro bancaire (Enable Banking) ---
# Identifiant de l'application (UUID affiché dans le Control Panel Enable Banking)
ENABLE_BANKING_APP_ID=
# Adresse de retour déclarée dans l'application Enable Banking
ENABLE_BANKING_REDIRECT_URL=http://localhost:8080/api/connections/callback
# Synchro automatique toutes les N heures (0 = désactivée)
SYNC_INTERVAL_HOURS=6
# Origines autorisées pour l'appli Android (par défaut : https://localhost,capacitor://localhost)
# CORS_ORIGINS=https://localhost,capacitor://localhost

# --- Sauvegardes automatiques chiffrées (service « backup », voir docs/sauvegardes.md) ---
# Clé publique age (age1…) : générée par `docker compose run --rm backup age-keygen`.
# La clé privée (AGE-SECRET-KEY-…) va dans ton gestionnaire de mots de passe, JAMAIS sur le serveur.
BACKUP_AGE_RECIPIENT=
# Toutes les N heures (défaut 24).
# BACKUP_INTERVAL_HOURS=24
# Copie hors machine avec rclone (optionnel) : nom du « remote » configuré dans backup/rclone.conf, ex. wallet-remote:sauvegardes
# BACKUP_RCLONE_REMOTE=
